+# Skillmark trust-tier hook. A verifier is any callable ``(skill_path: str) -> bool``.
+# The shipped implementation shells out to ``skillmark verify <path> --json`` and only
+# promotes a skill when the CLI reports ``"result": "verified"``. It never affects the
+# scan verdict: a dangerous verdict is still blocked by INSTALL_POLICY["verified"].
+import subprocess as _skillmark_subprocess
+
+SKILLMARK_VERIFIER = None
+
+
+def skillmark_verify_json(skill_path: str, binary: str = "skillmark") -> bool:
+    """Return True only when the Skillmark CLI reports a verified signature for this path."""
+    try:
+        proc = _skillmark_subprocess.run(
+            [binary, "verify", skill_path, "--json"], capture_output=True, text=True, timeout=120
+        )
+    except (OSError, _skillmark_subprocess.SubprocessError):
+        return False
+    if proc.returncode != 0:
+        return False
+    try:
+        return json.loads(proc.stdout).get("result") == "verified"
+    except (ValueError, AttributeError):
+        return False
+
+
+def maybe_promote_to_verified(result: Any, skill_path: str | None = None) -> Any:
+    """Promote a community scan result to the ``verified`` tier when the pluggable verifier agrees."""
+    verifier = SKILLMARK_VERIFIER or (lambda path: skillmark_verify_json(path) if path else False)
+    if result.trust_level == "community" and skill_path and verifier(skill_path):
+        result.trust_level = "verified"
+    return result
+
